<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v1.2：卡片留白收紧（用户 2026-10-04：「文字离卡片边缘太远、整卡太高」）——
         卡内边距 14→11dp，标签/输入/滑条行的纵向间距各收 1~2dp；只收不挤。 -->
    <style name="VtCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <!-- 内距 14→11→9dp：用户 2026-10-05 反馈"大部分卡片离边还是太远"（高度变矮可接受） -->
        <item name="android:padding">9dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="VtLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">13sp</item>
        <!-- 上边距 10→5→2dp：卡片里"内距 + 标签上距"叠起来太远（用户 2026-10-05 两次要求再收紧） -->
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="VtInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">9dp</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>
    <style name="VtSliderRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">7dp</item>
    </style>
    <style name="VtSliderLabel">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="VtSliderValue">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="VtMiniBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
</resources>
