<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v1.2：卡片留白收紧（用户 2026-10-04：「文字离卡片边缘太远、整卡太高」）——
         卡内边距 14→11dp，标签/输入/滑条行的纵向间距各收 1~2dp；只收不挤。 -->
    <style name="VtCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <!-- ⚠️ 只收"上边"！左右 12dp（用户 2026-10-06：左右被压到 6dp 太逼仄）
             顶距 = paddingTop 8dp（用户 2026-10-06 指定：5dp 太贴、改 8dp（2026-10-06 再 +1dp））；
             卡片里第一个元素的上边距由 LayoutFix 清零，所以顶距就是 7dp、不再叠加 -->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="VtLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">13sp</item>
        <!-- 恢复 10dp：这是"卡片中间那些标签"的上边距（我一度压到 2dp 太紧）；
             卡片里**第一个**元素的上边距由 LayoutFix 清零，所以顶距仍是 5dp -->
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="VtInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">9dp</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>
    <style name="VtSliderRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">7dp</item>
    </style>
    <style name="VtSliderLabel">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="VtSliderValue">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="VtMiniBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <!-- 时间 / 日期选择器：浅色弹窗（应用基类是深色 → 系统选择器默认一坨深灰） -->
    <style name="VtPicker" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/acc</item>
        <item name="android:textColorPrimary">#FF1F2329</item>
        <item name="android:textColorSecondary">#FF828A9B</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
    </style>
</resources>
