<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏响铃页：大字时间 + 谁在说话 + 贪睡 / 停止。配色由 Skin 按当前主题刷。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ringRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="88dp"
        android:paddingBottom="56dp">

        <TextView
            android:id="@+id/tvRingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/txt"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/tvRingDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRingWho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:gravity="center"
            android:textColor="@color/txt"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRingSnooze"
            style="@style/VtMiniBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRingStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

    </LinearLayout>
</FrameLayout>
