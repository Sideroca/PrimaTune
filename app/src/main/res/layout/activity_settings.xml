<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页 v2：5 个分页（模型/音色/主题/记录/关于）+ 底部坞 + 透明凹陷保存键 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wpImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wpScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：大标题 + 一条短 accent 下划线（往闪译「设置」那个观感靠） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.10"
                android:text="@string/label_model"
                android:textColor="@color/txt"
                android:textSize="30sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tvTitleUnderline"
                android:layout_width="52dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 5 个分页 -->
        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ① 模型 -->
            <ScrollView
                android:id="@+id/pageModel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- 语音 / 润色 两个子页切换（顶部） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnTabVoice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="30dp"
                            android:paddingVertical="9dp"
                            android:text="@string/llm_tab_voice"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/btnTabPolish"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:paddingHorizontal="30dp"
                            android:paddingVertical="9dp"
                            android:text="@string/llm_tab_polish"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ===== 语音：TTS 厂商配置 ===== -->
                    <LinearLayout
                        android:id="@+id/llVoiceCfg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout style="@style/VtCard">
                        <TextView
                            style="@style/VtLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/label_llm_provider" />

                        <AutoCompleteTextView
                            android:id="@+id/etProvider"
                            style="@style/VtInput"
                            android:completionThreshold="1"
                            android:hint="阿里云百炼 / OpenAI / Groq / Step / xAI"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tvBaseUrlLabel"
                            style="@style/VtLabel"
                            android:text="@string/label_base_url"
                            android:visibility="gone" />

                        <AutoCompleteTextView
                            android:id="@+id/etBaseUrl"
                            style="@style/VtInput"
                            android:completionThreshold="0"
                            android:hint="@string/hint_base_url"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvPathLabel"
                            style="@style/VtLabel"
                            android:text="@string/label_path"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/etPath"
                            style="@style/VtInput"
                            android:hint="/audio/speech"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvAuthLabel"
                            style="@style/VtLabel"
                            android:text="@string/label_auth"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/etAuth"
                            style="@style/VtInput"
                            android:hint="Authorization: Bearer {key}"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvKeyLabel"
                            style="@style/VtLabel"
                            android:text="@string/label_api_key2" />
                        <AutoCompleteTextView
                            android:id="@+id/etKey"
                            style="@style/VtInput"
                            android:completionThreshold="0"
                            android:hint="sk-ws-…"
                            android:importantForAutofill="no"
                            android:inputType="textVisiblePassword"
                            android:singleLine="true" />
                        <TextView
                            android:id="@+id/tvWsLabel"
                            style="@style/VtLabel"
                            android:text="@string/label_ws" />
                        <EditText
                            android:id="@+id/etWs"
                            style="@style/VtInput"
                            android:hint="ws-xxxxxxxx"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />
                        <TextView style="@style/VtLabel" android:text="@string/label_default_model" />
                        <AutoCompleteTextView
                        android:id="@+id/etModel"
                        style="@style/VtInput"
                        android:hint="cosyvoice-v3.5-plus"
                        android:completionThreshold="1"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:singleLine="true" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btnPaste"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_paste"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/btnSaveKey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_save_api"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/sec_llm_model" />

                        <LinearLayout
                            android:id="@+id/llProviders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                                            </LinearLayout>

                    </LinearLayout>

                    <!-- ===== 润色：LLM 总配置（润色 / 翻译 / 智能填参 共用）===== -->
                    <LinearLayout
                        android:id="@+id/llPolishCfg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout style="@style/VtCard">
                            <TextView
                                style="@style/VtLabel"
                                android:layout_marginTop="0dp"
                                android:text="@string/label_llm_title" />

                            <AutoCompleteTextView
                                android:id="@+id/etLlmProvider"
                                style="@style/VtInput"
                                android:hint="@string/hint_llm_provider"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:singleLine="true" />

                            <EditText
                                android:id="@+id/etLlmBase"
                                style="@style/VtInput"
                                android:hint="@string/hint_llm_base"
                                android:importantForAutofill="no"
                                android:inputType="textUri"
                                android:singleLine="true" />

                            <EditText
                                android:id="@+id/etLlmKey"
                                style="@style/VtInput"
                                android:hint="@string/hint_llm_key"
                                android:importantForAutofill="no"
                                android:inputType="textVisiblePassword"
                                android:singleLine="true" />

                            <AutoCompleteTextView
                                android:id="@+id/etLlmModel"
                                style="@style/VtInput"
                                android:completionThreshold="0"
                                android:hint="@string/hint_llm_model"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:singleLine="true" />

                            <EditText
                                android:id="@+id/etLlmMaxTokens"
                                style="@style/VtInput"
                                android:hint="@string/hint_llm_tokens"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:singleLine="true" />

                            <TextView style="@style/VtLabel" android:text="@string/label_llm_level" />
                            <LinearLayout
                                android:id="@+id/llLlmLevels"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal" />

                            <EditText
                                android:id="@+id/etLlmTemp"
                                style="@style/VtInput"
                                android:hint="@string/hint_llm_temp"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal"
                                android:singleLine="true" />

                            <TextView style="@style/VtLabel" android:text="@string/label_polish_prompt" />
                            <EditText
                                android:id="@+id/etLlmPrompt"
                                style="@style/VtInput"
                                android:gravity="top|start"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine"
                                android:minLines="5" />

                            <TextView style="@style/VtLabel" android:text="@string/label_trans_prompt" />
                            <EditText
                                android:id="@+id/etTransPrompt"
                                style="@style/VtInput"
                                android:gravity="top|start"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine"
                                android:minLines="4" />

                            <TextView style="@style/VtLabel" android:text="@string/label_trans_email" />
                            <EditText
                                android:id="@+id/etTransEmail"
                                style="@style/VtInput"
                                android:hint="@string/hint_trans_email"
                                android:importantForAutofill="no"
                                android:inputType="textEmailAddress"
                                android:singleLine="true" />

                            <TextView style="@style/VtLabel" android:text="@string/label_llm_extra" />
                            <EditText
                                android:id="@+id/etLlmExtra"
                                style="@style/VtInput"
                                android:gravity="top|start"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine"
                                android:minLines="2" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/btnLlmTest"
                                    style="@style/VtMiniBtn"
                                    android:text="@string/btn_llm_test" />

                                <TextView
                                    android:id="@+id/tvLlmTest"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:paddingStart="6dp"
                                    android:textColor="@color/dim"
                                    android:textSize="12.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ② 音色 -->
            <ScrollView
                android:id="@+id/pageVoice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/sec_voice_mgmt" />
                        <LinearLayout
                            android:id="@+id/llVoices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ③ 主题 -->
            <ScrollView
                android:id="@+id/pageTheme"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- 快捷图标工坊：App 图标样式 + 桌面入口（仿闪译） -->
                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/sec_icon" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sec_icon_workshop"
                            android:textColor="@color/dim"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvIconHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/note_icon"
                            android:textColor="@color/hint"
                            android:textSize="11.5sp" />

                        <ImageView
                            android:id="@+id/ivIconPreview"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginTop="10dp"
                            android:scaleType="fitCenter" />

                        <TextView style="@style/VtLabel" android:text="@string/label_style" />
                        <LinearLayout
                            android:id="@+id/llIconStyles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btnPinEntry"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_btn_primary"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="@string/btn_pin_entry"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/btnIconReset"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="@string/btn_icon_reset"
                                android:textColor="@color/dim"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/note_custom_icon"
                            android:textColor="@color/dim"
                            android:textSize="11.5sp" />

                        <EditText
                            android:id="@+id/etEntryName"
                            style="@style/VtInput"
                            android:hint="@string/hint_entry_name"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/btnPinCustom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_btn_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:padding="12dp"
                            android:text="@string/btn_pin_custom"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/note_shortcut_perm"
                            android:textColor="@color/hint"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 分类按钮：常驻，不随下面两张卡切换而消失（否则进了"壁纸属性"就回不来） -->
                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/sec_theme" />
                        <LinearLayout
                            android:id="@+id/llCats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardPalette"
                        style="@style/VtCard">
                        <LinearLayout
                            android:id="@+id/llPalettes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- 壁纸与浓度（属于「主题」页） -->
                    <LinearLayout
                        android:id="@+id/cardWallpaper"
                        style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/label_wp_main" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btnWpMain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_pick_image"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/btnWpMainClear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_clear_wp"
                                android:textColor="@color/dim"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvWpMainState"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/wp_unset"
                                android:textColor="@color/dim"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout style="@style/VtSliderRow">
                            <TextView style="@style/VtSliderLabel" android:text="@string/label_scrim" />
                            <SeekBar
                                android:id="@+id/sbScrimMain"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100" />
                            <TextView
                                android:id="@+id/tvScrimMain"
                                style="@style/VtSliderValue"
                                android:text="35%" />
                        </LinearLayout>

                        <TextView style="@style/VtLabel" android:text="@string/label_wp_page" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btnWpPage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_pick_image"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/btnWpPageClear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_clear_wp"
                                android:textColor="@color/dim"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvWpPageState"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/wp_unset"
                                android:textColor="@color/dim"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout style="@style/VtSliderRow">
                            <TextView style="@style/VtSliderLabel" android:text="@string/label_scrim" />
                            <SeekBar
                                android:id="@+id/sbScrimPage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100" />
                            <TextView
                                android:id="@+id/tvScrimPage"
                                style="@style/VtSliderValue"
                                android:text="35%" />
                        </LinearLayout>
                        <LinearLayout style="@style/VtSliderRow">
                            <TextView style="@style/VtSliderLabel" android:text="@string/label_card" />
                            <SeekBar
                                android:id="@+id/sbCardAlpha"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100"
                                android:min="0" />
                            <TextView
                                android:id="@+id/tvCardAlpha"
                                style="@style/VtSliderValue"
                                android:text="100%" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnWpReset"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:padding="11dp"
                            android:text="@string/btn_wp_reset"
                            android:textColor="@color/dim"
                            android:textSize="14sp" />

                        <!-- 记录字号：只影响记录卡的标题/信息/详情（小按钮不动）。用户 2026-10-05 -->
                        <TextView style="@style/VtLabel" android:text="@string/label_font_scale" />
                        <LinearLayout
                            android:id="@+id/llFontScale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- 指示符颜色（与壁纸模块对调后放到后面） -->
                    <LinearLayout
                        android:id="@+id/cardIndicator"
                        style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/label_indicator" />
                        <LinearLayout
                            android:id="@+id/llIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ④ 记录 -->
            <ScrollView
                android:id="@+id/pageRecords"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout style="@style/VtCard">
                        <!-- 先筛选（一排），再搜索栏（一行）——三行堆一起太挤 -->
                        <LinearLayout
                            android:id="@+id/llRecTop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                        <EditText
                            android:id="@+id/etRecSearch"
                            style="@style/VtInput"
                            android:hint="@string/hint_rec_search"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />
                        <LinearLayout
                            android:id="@+id/llRecords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ⑤ 关于 -->
            <ScrollView
                android:id="@+id/pageAbout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/sec_tips" />

                        <!-- 提示内容（分组 + 分隔线；由代码按主题排版）——「使用提示 / 关于」放前面 -->
                        <LinearLayout
                            android:id="@+id/llTips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- 「检查更新」按用户要求挪到**第 3 格**（使用提示 → 关于 → 检查更新） -->
                        <TextView
                            android:id="@+id/btnCheckUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:padding="11dp"
                            android:text="@string/btn_check_update"
                            android:textColor="@color/txt"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 开发者联系与支持（仿闪译；整块点一下复制） -->
                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="@string/sec_dev" />

                        <TextView
                            android:id="@+id/tvDevInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/txt"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDevCopyHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/dev_copy_hint"
                            android:textColor="@color/dim"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- 底部：坞 + 保存键（常驻 5 页） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/llDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <com.sideroca.voicetuner.PressButton
                android:id="@+id/btnSaveAll"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
