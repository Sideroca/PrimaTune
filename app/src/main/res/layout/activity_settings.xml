<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页 v2：5 个分页（模型/音色/主题/记录/关于）+ 底部坞 + 透明凹陷保存键 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wpImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wpScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="模型"
                android:textColor="@color/txt"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5 个分页 -->
        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ① 模型 -->
            <ScrollView
                android:id="@+id/pageModel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="厂商（输入关键字即匹配）" />

                        <AutoCompleteTextView
                            android:id="@+id/etProvider"
                            style="@style/VtInput"
                            android:completionThreshold="1"
                            android:hint="阿里云百炼 / OpenAI / Groq / Step / xAI"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tvBaseUrlLabel"
                            style="@style/VtLabel"
                            android:text="Base URL（已自动填好，一般不用改；走代理/中转才动）"
                            android:visibility="gone" />

                        <AutoCompleteTextView
                            android:id="@+id/etBaseUrl"
                            style="@style/VtInput"
                            android:completionThreshold="0"
                            android:hint="https://你的域名/v1"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvPathLabel"
                            style="@style/VtLabel"
                            android:text="端点路径（留空 = 按形态默认）"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/etPath"
                            style="@style/VtInput"
                            android:hint="/audio/speech"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvAuthLabel"
                            style="@style/VtLabel"
                            android:text="鉴权头（{key} 替换成你的 Key）"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/etAuth"
                            style="@style/VtInput"
                            android:hint="Authorization: Bearer {key}"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvKeyLabel"
                            style="@style/VtLabel"
                            android:text="API Key（当前厂商；仅保存在本机）" />
                        <AutoCompleteTextView
                            android:id="@+id/etKey"
                            style="@style/VtInput"
                            android:completionThreshold="0"
                            android:hint="sk-ws-…"
                            android:importantForAutofill="no"
                            android:inputType="textVisiblePassword"
                            android:singleLine="true" />
                        <TextView
                            android:id="@+id/tvWsLabel"
                            style="@style/VtLabel"
                            android:text="业务空间 ID" />
                        <EditText
                            android:id="@+id/etWs"
                            style="@style/VtInput"
                            android:hint="ws-xxxxxxxx"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />
                        <TextView style="@style/VtLabel" android:text="默认 model" />
                        <AutoCompleteTextView
                        android:id="@+id/etModel"
                        style="@style/VtInput"
                        android:hint="cosyvoice-v3.5-plus"
                        android:completionThreshold="1"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:singleLine="true" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btnPaste"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="📋 粘贴剪贴板"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/btnSaveKey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="保存接口设置"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="模型（可对接多家语音合成）" />

                        <LinearLayout
                            android:id="@+id/llProviders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                                            </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ② 音色 -->
            <ScrollView
                android:id="@+id/pageVoice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="音色管理" />
                        <LinearLayout
                            android:id="@+id/llVoices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ③ 主题 -->
            <ScrollView
                android:id="@+id/pageTheme"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- 预览台：实时反映 配色 / 壁纸 / 遮罩（玲珑调音的做法） -->
                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="预览台（实时）" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">
                            <com.sideroca.voicetuner.ThemePreviewView
                                android:id="@+id/preview"
                                android:layout_width="104dp"
                                android:layout_height="220dp" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:id="@+id/btnPvMain"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:paddingHorizontal="14dp"
                                        android:paddingVertical="7dp"
                                        android:text="主界面"
                                        android:textSize="12.5sp" />
                                    <TextView
                                        android:id="@+id/btnPvPage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:paddingHorizontal="14dp"
                                        android:paddingVertical="7dp"
                                        android:text="设置页"
                                        android:textSize="12.5sp" />
                                </LinearLayout>
                                <TextView
                                    android:id="@+id/tvPvHint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:lineSpacingExtra="3dp"
                                    android:text="配色、壁纸、遮罩、卡片浓度都会实时反映到左边这块小屏；下面「壁纸与浓度」拖动即可看到变化。"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 分类按钮：常驻，不随下面两张卡切换而消失（否则进了"壁纸属性"就回不来） -->
                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="主题配色（点选即换）" />
                        <LinearLayout
                            android:id="@+id/llCats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardPalette"
                        style="@style/VtCard">
                        <LinearLayout
                            android:id="@+id/llPalettes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- 壁纸与浓度（属于「主题」页） -->
                    <LinearLayout
                        android:id="@+id/cardWallpaper"
                        style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="主界面壁纸" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btnWpMain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="选择图片"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/btnWpMainClear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="清除"
                                android:textColor="@color/dim"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvWpMainState"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="未设置"
                                android:textColor="@color/dim"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout style="@style/VtSliderRow">
                            <TextView style="@style/VtSliderLabel" android:text="遮罩" />
                            <SeekBar
                                android:id="@+id/sbScrimMain"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="80" />
                            <TextView
                                android:id="@+id/tvScrimMain"
                                style="@style/VtSliderValue"
                                android:text="35%" />
                        </LinearLayout>

                        <TextView style="@style/VtLabel" android:text="设置页壁纸" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/btnWpPage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="选择图片"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/btnWpPageClear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="清除"
                                android:textColor="@color/dim"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvWpPageState"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="未设置"
                                android:textColor="@color/dim"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout style="@style/VtSliderRow">
                            <TextView style="@style/VtSliderLabel" android:text="遮罩" />
                            <SeekBar
                                android:id="@+id/sbScrimPage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="80" />
                            <TextView
                                android:id="@+id/tvScrimPage"
                                style="@style/VtSliderValue"
                                android:text="35%" />
                        </LinearLayout>
                        <LinearLayout style="@style/VtSliderRow">
                            <TextView style="@style/VtSliderLabel" android:text="卡片" />
                            <SeekBar
                                android:id="@+id/sbCardAlpha"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100"
                                android:min="30" />
                            <TextView
                                android:id="@+id/tvCardAlpha"
                                style="@style/VtSliderValue"
                                android:text="100%" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnWpReset"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:padding="11dp"
                            android:text="恢复默认（壁纸与浓度）"
                            android:textColor="@color/dim"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 指示符颜色（与壁纸模块对调后放到后面） -->
                    <LinearLayout
                        android:id="@+id/cardIndicator"
                        style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="当前音色指示符颜色" />
                        <LinearLayout
                            android:id="@+id/llIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ④ 记录 -->
            <ScrollView
                android:id="@+id/pageRecords"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="本地记录（主页那份也保留）" />
                        <LinearLayout
                            android:id="@+id/llRecords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ⑤ 关于 -->
            <ScrollView
                android:id="@+id/pageAbout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="关于" />

                        <TextView
                            android:id="@+id/btnCheckUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:padding="11dp"
                            android:text="检查更新"
                            android:textColor="@color/txt"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:text="玲珑调音 · Prima Tune\n版本 v0.5.5\n\n· 语音合成：已接入 10 家厂商 + 本机系统 TTS + 自定义渠道\n· 音色：内置 4 个 + 自建（声音复刻）\n· 外观：64 套配色 · 指示符颜色 · 壁纸（支持二次截取）\n· 数据：全部只保存在本机，不上传\n\n许可与致谢\n· 界面设计参照《夕汀前端规范》\n· 各第三方模型与名称归各自厂商所有"
                            android:textColor="@color/dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- 开发者联系与支持（仿闪译；整块点一下复制） -->
                    <LinearLayout style="@style/VtCard">
                        <TextView style="@style/VtLabel" android:text="开发者联系与支持" />

                        <TextView
                            android:id="@+id/tvDevInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/txt"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDevCopyHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="点一下复制"
                            android:textColor="@color/dim"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- 底部：坞 + 保存键（常驻 5 页） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/llDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <com.sideroca.voicetuner.PressButton
                android:id="@+id/btnSaveAll"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
